<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Generated report PDFs shared via ACTION_SEND -->
    <files-path name="reports" path="vims/users/" />
    <!-- Camera captures for profile photos / company logo (TakePicture writes here, then we crop + copy) -->
    <cache-path name="capture" path="capture/" />
    <!-- State documents (stateRules docs, copied from assets) for View / Send to client -->
    <cache-path name="state_docs" path="state-docs/" />
    <!-- Company's own uploaded inspection agreement (Company profile → View your file) -->
    <files-path name="company_docs" path="vims/companies/" />
</paths>
