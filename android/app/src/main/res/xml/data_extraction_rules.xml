<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): the same rule as backup_rules.xml, for the cloud backup and for device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="vims_device.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="vims_device.xml" />
    </device-transfer>
</data-extraction-rules>
