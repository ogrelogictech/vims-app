<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Cloud backup: same rule as backup_rules.xml, only vims_device.xml leaves the device.
     Device-to-device transfer has no rule, so the user's inspections move when they set up their own new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="vims_device.xml" />
    </cloud-backup>
</data-extraction-rules>
