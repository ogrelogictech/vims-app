<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- VIMS is light-only (matches the approved prototype). Force-dark is disabled so OS dark mode never restyles the UI. -->
    <style name="Theme.VIMS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vims_paper2</item>
        <item name="android:colorAccent">@color/vims_hdr</item>
        <item name="android:colorPrimary">@color/vims_hdr</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- Android 12+ SplashScreen API (compat on 8–11): light gray, no icon, then the in-app splash video. -->
    <style name="Theme.VIMS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vims_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.VIMS</item>
    </style>
</resources>
